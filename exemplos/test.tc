funcao add(a:int,b:int):int {
	retorna a+b
}

funcao addreal(a:real,b:real):real {
	retorna a+b
}

int x = add(add(3,3),3)
Saida.escreva("valor de x é ")
Saida.escreval(x)

real y = addreal(1.5,2.2)
Saida.escreva("valor de y é ")
Saida.escreval(y)

caractere nome = Entrada.pergunte("Digite seu nome: ")
se (nome=="leonna") {
	Saida.escreval("eba você é foda")
} senao {
	Saida.escreval("aff vc é paia")
}
