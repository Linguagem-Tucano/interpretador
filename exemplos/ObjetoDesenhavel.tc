classe ObjetoDesenhavel {
    int x = 0
    int y = 0
    int w = 0
    int h = 0
    caractere imgId = ""

    construtor(x,y,w,h,imgid) {
        isso.x = x
        isso.y = y
        isso.w = w
        isso.h = h
        isso.imgId = imgid
        retorna isso
    }

    funcao desenhar() {
        escreval("CANVASCOMMAND::img;"..isso.imgId..";"..isso.x..";"..isso.y..";"..isso.w..";"..isso.h)
    }

    funcao mover(x,y) {
        isso.x = x
        isso.y = y
    }
}