classe Fruta {
  var nome: texto

  funcao construtor(n) {
    isso.nome = n
    retorna isso
  }
  funcao falarNome() {
    Saida.escreval(isso.nome) --escreva na tela o nome dessa fruta
  }
}

var uva: Fruta = novo Fruta("uva") --criar um objeto fruta com nome uva
var melao: Fruta = novo Fruta("melao") --criar um objeto fruta com nome melao
melao.falarNome() --o melao vai escrever "melao" na tela pois é essa instancia que está executando.